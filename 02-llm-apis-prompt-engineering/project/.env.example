# ============================================================================
# Phase 2: LLM APIs & Prompt Engineering Configuration
# ============================================================================

# Optional: Add your API keys below to test with real live models.
# If left blank, the project automatically uses the built-in high-fidelity
# Mock Provider so you can test all features offline with ZERO cost!
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default Model Selection:
# Examples for OpenAI: gpt-4o, gpt-4o-mini
# Examples for Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# Examples for Gemini: gemini-2.5-flash, gemini-1.5-pro
DEFAULT_MODEL=gpt-4o-mini

# Generation Hyperparameters
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1000
